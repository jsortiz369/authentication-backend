{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "roots": ["<rootDir>/test/unit"],
  "testMatch": ["<rootDir>/test/unit/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "moduleDirectories": ["node_modules", "<rootDir>/test/unit"]
}
